#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: The Lounge
# This adds the default user and installs any requested themes
# ==============================================================================
declare users
declare user_found

readonly thelounge_defaults=/usr/local/share/.config/yarn/global/node_modules/thelounge/dist/defaults/config.js

export THELOUNGE_HOME=/data/thelounge

# Require a user
bashio::config.require "users"

mkdir -p /data/thelounge/users

# The Lounge only writes its configuration file when the server starts, while
# installing a theme already requires that file to be present. Seed it from the
# packaged defaults, so themes install on the very first run as well.
if ! bashio::fs.file_exists "/data/thelounge/config.js"; then
    if bashio::fs.file_exists "${thelounge_defaults}"; then
        cp "${thelounge_defaults}" /data/thelounge/config.js
    else
        bashio::log.warning \
            "Could not find the packaged default configuration of The Lounge;" \
            "themes might not install until the next restart."
    fi
fi

# List current users
/usr/local/bin/thelounge list

users=$(bashio::config "users")

for user in $users
do
    if ! bashio::fs.file_exists "/data/thelounge/users/${user}.json"; then
        bashio::log.info "Creating user ${user} with default password.."
        cp /etc/thelounge/users/hassio.json "/data/thelounge/users/${user}.json"
    fi
done

# Delete removed users
for file in /data/thelounge/users/*.json
do
    # Guard against the glob not matching anything
    bashio::fs.file_exists "${file}" || continue

    user_found=false
    for user in $users
    do
        if [ "$(basename "${file}" .json)" == "${user}" ]; then
            user_found=true
            break
        fi
    done
    if [ ! "$user_found" == true ]; then
        bashio::log.info "Removing removed user ${file}.."
        rm -f "$file"
    fi
done

for theme in $(bashio::config "themes")
do
    /usr/local/bin/thelounge install "${theme}"
done
